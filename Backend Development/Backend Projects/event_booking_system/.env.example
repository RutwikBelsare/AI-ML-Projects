# Copy this file to .env and fill in real values. Never commit the real .env.

# Postgres connection (async driver -> postgresql+asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/event_booking

# JWT
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Redis (cache + rate limiting + celery result backend)
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
